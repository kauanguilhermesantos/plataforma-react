generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["koda_schema"]
}

model admin {
  id_usuario Int     @id
  curso      curso[]

  @@schema("koda_schema")
}

model aluno {
  id_usuario                                                                                                                       Int                  @id
  bio                                                                                                                              String?
  data_entrada                                                                                                                     DateTime?            @default(dbgenerated("CURRENT_DATE")) @db.Date
  estilo_aprendizagem                                                                                                              String?              @db.VarChar(50)
  primeiro_acesso                                                                                                                  Boolean?             @default(true)
  ativista_score                                                                                                                   Int?
  reflexivo_score                                                                                                                  Int?
  teorico_score                                                                                                                    Int?
  pragmatico_score                                                                                                                 Int?
  estilo_aprendizagem_aluno_estilo_aprendizagem_ativista_score_reflexivo_score_teorico_score_pragmatico_scoreToestilo_aprendizagem estilo_aprendizagem? @relation("aluno_estilo_aprendizagem_ativista_score_reflexivo_score_teorico_score_pragmatico_scoreToestilo_aprendizagem", fields: [estilo_aprendizagem, ativista_score, reflexivo_score, teorico_score, pragmatico_score], references: [estilo_aprendizagem_dominante, ativista_score, reflexivo_score, teorico_score, pragmatico_score], onDelete: NoAction, onUpdate: NoAction, map: "estilo_aprendizagem_dominante")

  @@schema("koda_schema")
}

model instrutor {
  id_instrutor Int     @id @default(autoincrement())
  nome         String  @db.VarChar(100)
  bio          String?
  foto         String? @db.VarChar(255)
  curso        curso[]

  @@schema("koda_schema")
}

model usuario {
  id_usuario      Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  sobrenome       String?   @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  senha           String    @db.VarChar(255)
  telefone        String?   @db.VarChar(20)
  localizacao     String?   @db.VarChar(100)
  data_nascimento DateTime? @db.Date
  foto            String?   @db.VarChar(255)
  aceitar_termos  Boolean?

  @@schema("koda_schema")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model estilo_aprendizagem {
  estilo_aprendizagem_dominante                                                                                      String  @db.VarChar(50)
  ativista_score                                                                                                     Int
  reflexivo_score                                                                                                    Int
  teorico_score                                                                                                      Int
  pragmatico_score                                                                                                   Int
  aluno_aluno_estilo_aprendizagem_ativista_score_reflexivo_score_teorico_score_pragmatico_scoreToestilo_aprendizagem aluno[] @relation("aluno_estilo_aprendizagem_ativista_score_reflexivo_score_teorico_score_pragmatico_scoreToestilo_aprendizagem")

  @@id([estilo_aprendizagem_dominante, ativista_score, reflexivo_score, teorico_score, pragmatico_score])
  @@schema("koda_schema")
}

model aula {
  id_aula   Int     @id @default(autoincrement())
  titulo    String  @db.VarChar(255)
  duracao   Int?
  descricao String?
  ordem     Int
  arquivo   String? @db.VarChar(500)
  status    String  @default("Rascunho") @db.VarChar(50)
  id_modulo Int
  modulo    modulo  @relation(fields: [id_modulo], references: [id_modulo], onDelete: Cascade, onUpdate: NoAction)

  @@schema("koda_schema")
}

model curso {
  id_curso            Int       @id @default(autoincrement())
  titulo              String    @db.VarChar(200)
  descricao           String?
  thumbnail           String?   @db.VarChar(500)
  categoria           String?   @db.VarChar(100)
  nivel               String?   @db.VarChar(50)
  status              String?   @default("Rascunho") @db.VarChar(20)
  estilo_aprendizagem String?   @db.VarChar(100)
  id_instrutor        Int
  id_usuario          Int
  instrutor           instrutor @relation(fields: [id_instrutor], references: [id_instrutor], onDelete: NoAction, onUpdate: NoAction)
  admin               admin     @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  modulo              modulo[]
  recurso             recurso[]
  tags                tags[]

  @@schema("koda_schema")
}

model modulo {
  id_modulo Int     @id @default(autoincrement())
  titulo    String  @db.VarChar(255)
  descricao String?
  ordem     Int
  status    String  @default("Rascunho") @db.VarChar(50)
  id_curso  Int
  aula      aula[]
  curso     curso   @relation(fields: [id_curso], references: [id_curso], onDelete: NoAction, onUpdate: NoAction)

  @@schema("koda_schema")
}

model recurso {
  id_recurso Int     @id @default(autoincrement())
  titulo     String  @db.VarChar(255)
  arquivo    String? @db.VarChar(500)
  id_curso   Int
  curso      curso   @relation(fields: [id_curso], references: [id_curso], onDelete: NoAction, onUpdate: NoAction)

  @@schema("koda_schema")
}

model tags {
  id_curso Int
  nome_tag String @db.VarChar(100)
  curso    curso  @relation(fields: [id_curso], references: [id_curso], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_curso, nome_tag])
  @@schema("koda_schema")
}
